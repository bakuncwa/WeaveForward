# ============================================================
# WeaveForward Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in all values marked
# REQUIRED before deploying to GCP Cloud Run.
# Variables marked OPTIONAL use safe defaults if omitted.
# ============================================================


# ----------------------------
# Environment
# REQUIRED — must be "production" for GCP deployment.
# ----------------------------
ENVIRONMENT=production


# ----------------------------
# Django Core
# REQUIRED — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ----------------------------
SECRET_KEY=replace-with-your-secret-key
DEBUG=False


# ----------------------------
# Allowed Hosts
# REQUIRED — set to your Cloud Run service URL(s).
# Example: weaveforward-backend-xxxx-as.a.run.app
# ----------------------------
ALLOWED_HOSTS=your-backend-service-url.run.app


# ----------------------------
# Cloud SQL (MySQL) — GCP
# REQUIRED — connection name format: project-id:region:instance-name
# ----------------------------
DB_NAME=weaveforward_db
DB_USER=root
DB_PASSWORD=replace-with-your-cloud-sql-password
CLOUD_SQL_CONNECTION_NAME=your-project-id:asia-southeast1:weaveforward-db


# ----------------------------
# Admin Seed Account
# REQUIRED — used by bootstrap_environment management command.
# ----------------------------
ADMIN_EMAIL=admin@weaveforward.com
ADMIN_PASSWORD=replace-with-your-admin-password


# ----------------------------
# Security Cookies
# REQUIRED — must be True in production over HTTPS.
# ----------------------------
AUTH_COOKIE_SECURE=True


# ----------------------------
# Cloud Storage (GCS) — Media & Static Files
# REQUIRED — bucket must exist and be publicly readable.
# ----------------------------
GS_BUCKET_NAME=replace-with-your-gcs-bucket-name
GS_PROJECT_ID=replace-with-your-gcp-project-id


# ----------------------------
# ML Catalog CSV Path
# OPTIONAL — defaults to webscraped_catalog_archive.csv if omitted.
# ----------------------------
CATALOG_CSV_PATH=backend/data/webscraped_data/webscraped_catalog_archive.csv


# ----------------------------
# Resend (Transactional Email)
# REQUIRED — used for password reset, match notifications, flag alerts.
# Get from: https://resend.com → API Keys
# ----------------------------
RESEND_API_KEY=replace-with-your-resend-api-key


# ----------------------------
# Maya Payments (Sandbox)
# REQUIRED — used for TUAB subscription and delivery order payments.
# Get from: https://developers.maya.ph → Sandbox credentials
# For production, replace sandbox URL with live Maya endpoint.
# ----------------------------
MAYA_API_SECRET_KEY=replace-with-your-maya-secret-key
MAYA_API_PUBLIC_KEY=replace-with-your-maya-public-key
MAYA_SANDBOX_BASE_URL=https://pg-sandbox.paymaya.com/payments/v1


# ----------------------------
# Lalamove Delivery
# REQUIRED — used for delivery booking and order tracking.
# Get from: https://developers.lalamove.com → Sandbox credentials
# For production, replace with: https://rest.lalamove.com
# ----------------------------
LALAMOVE_API_KEY=replace-with-your-lalamove-api-key
LALAMOVE_API_SECRET=replace-with-your-lalamove-api-secret
LALAMOVE_BASE_URL=https://rest.sandbox.lalamove.com


# ----------------------------
# Cloud Scheduler Auth Secret
# REQUIRED — any strong random string; must match the value set
# in the Cloud Scheduler job's X-Scheduler-Secret header.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ----------------------------
SCHEDULER_SECRET=replace-with-your-scheduler-secret


# ----------------------------
# Server Port (Cloud Run)
# OPTIONAL — Cloud Run injects $PORT automatically; only set if overriding.
# ----------------------------
# PORT=8080
