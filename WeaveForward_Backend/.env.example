# ============================================================
# WeaveForward Backend - Environment Configuration
# Cloud/production-oriented example.
# For local development, use the README local .env block and the local notes below.
# ============================================================

# ----------------------------
# Environment
# Cloud/production:
# ----------------------------
ENVIRONMENT=production
DEBUG=False

# Local development:
# ENVIRONMENT=development
# DEBUG=True

# ----------------------------
# Django Core
# ----------------------------
SECRET_KEY=replace-with-your-secret-key

# ----------------------------
# Allowed Hosts and Browser Origins
# Comma-separate multiple values.
# ----------------------------
ALLOWED_HOSTS=your-backend-host.example.com
CORS_ALLOWED_ORIGINS=https://your-frontend-host.example.com
CSRF_TRUSTED_ORIGINS=https://your-frontend-host.example.com

# ----------------------------
# Cloud SQL (MySQL)
# Cloud/production uses CLOUD_SQL_CONNECTION_NAME.
# Local development should remove/comment out CLOUD_SQL_CONNECTION_NAME
# and add DB_HOST=127.0.0.1 / DB_PORT=3306 instead.
# ----------------------------
DB_NAME=weaveforward_db
DB_USER=replace-with-your-mysql-user
DB_PASSWORD=replace-with-your-mysql-password
CLOUD_SQL_CONNECTION_NAME=your-project-id:asia-southeast1:your-instance-name

# ----------------------------
# Security
# Cloud/production: True
# Local development: False
# ----------------------------
AUTH_COOKIE_SECURE=True

# ----------------------------
# Cloud Storage (GCS)
# Omit both for local development unless USE_GCS=True is set.
# ----------------------------
GS_BUCKET_NAME=replace-with-your-bucket-name
GS_PROJECT_ID=replace-with-your-project-id

# ----------------------------
# ML Catalog
# ----------------------------
CATALOG_CSV_PATH=backend/data/webscraped_data/webscraped_catalog_archive.csv
DJANGO_ML_DIR=fiber_match_api/models

# ----------------------------
# Resend (Email)
# Required for production email sending.
# For local email testing, replace this with a real Resend API key.
# ----------------------------
RESEND_API_KEY=replace-with-your-resend-api-key

# ----------------------------
# Maya Payments (Sandbox)
# Required for subscription/payment flows.
# For local payment testing, replace these with real Maya sandbox keys.
# ----------------------------
MAYA_API_SECRET_KEY=replace-with-your-maya-secret-key
MAYA_API_PUBLIC_KEY=replace-with-your-maya-public-key
MAYA_SANDBOX_BASE_URL=https://pg-sandbox.paymaya.com/payments/v1

# ----------------------------
# Lalamove Delivery (Sandbox)
# Required for delivery quotation/booking flows.
# For local delivery testing, replace these with real Lalamove sandbox keys.
# ----------------------------
LALAMOVE_API_KEY=replace-with-your-lalamove-api-key
LALAMOVE_API_SECRET=replace-with-your-lalamove-api-secret
LALAMOVE_BASE_URL=https://rest.sandbox.lalamove.com

# ----------------------------
# Cloud Scheduler Auth Secret
# Required for production scheduled-job authentication.
# For local development, use any dev-only value unless testing scheduler calls.
# ----------------------------
SCHEDULER_SECRET=replace-with-your-scheduler-secret
