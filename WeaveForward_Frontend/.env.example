# ============================================================
# WeaveForward Frontend — Environment Variables
# ============================================================
# Copy this file to .env and fill in all values marked
# REQUIRED before deploying to GCP Cloud Run.
# ============================================================


# ----------------------------
# Django Core
# REQUIRED — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ----------------------------
SECRET_KEY=replace-with-your-secret-key
DEBUG=False


# ----------------------------
# Backend API URL
# REQUIRED — set to your deployed backend Cloud Run service URL.
# Must include trailing /api/
# Example: https://weaveforward-backend-xxxx-as.a.run.app/api/
# ----------------------------
BACKEND_BASE_URL=https://your-backend-service-url.run.app/api/
